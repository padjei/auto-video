      "headline": "We design it. We build it.",
      "caption": "Depth 01",
      "diagram": {
        "depth": 0,
        "active": "orchestration",
        "tiers": ["Interface", "Service", "Platform", "Substrate"]
      }
    },
    {
      "id": "s04-whiteboard",
      "type": "engineeringVignette",
      "durationInFrames": 160,
      "transition": "cut",
      "camera": "settle",
      "headline": "Engineers.",
      "media": "assets/nista-launch/whiteboard.jpg"
    },
    {
      "id": "s05-keyboard",
      "type": "engineeringVignette",
      "durationInFrames": 160,
      "transition": "strataDescent",
      "camera": "push",
      "headline": "Not intermediaries.",
      "media": "assets/nista-launch/keyboard.jpg"
    },
    {
      "id": "s06-assurance",
      "type": "assuranceTriad",
      "durationInFrames": 107,
      "transition": "cut",
      "camera": "settle",
      "triad": [
        {"label": "01", "title": "Availability"},
        {"label": "02", "title": "Integrity"},
        {"label": "03", "title": "Recovery"}
      ]
    },
    {
      "id": "s07-not-bolted-on",
      "type": "statementCard",
      "durationInFrames": 161,
      "transition": "cut",
      "camera": "push",
      "eyebrow": "First-class requirements",
