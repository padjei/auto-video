{
  "id": "nista-launch",
  "title": "NISTA Technologies — Launch Film",
  "width": 1920,
  "height": 1080,
  "fps": 30,
  "background": "#0B1523",
  "foreground": "#F2EFE8",
  "accent": "#C6A15B",
  "voiceover": "assets/nista-launch/mix.wav",
  "scenes": [
    {
      "id": "s01-hook",
      "type": "cinematicPlate",
      "durationInFrames": 135,
      "transition": "cut",
      "camera": "push",
      "headline": "Your systems cannot\nfail quietly.",
      "media": "assets/nista-launch/ops-floor.jpg"
    },
    {
      "id": "s02-problem",
      "type": "statementCard",
      "durationInFrames": 209,
      "transition": "cut",
      "camera": "settle",
      "eyebrow": "The failure mode",
      "headline": "Modernization fails\nin delivery."
    },
    {
      "id": "s03-positioning",
      "type": "architectureDiagram",
      "durationInFrames": 233,
      "transition": "strataWipe",
      "camera": "push",
